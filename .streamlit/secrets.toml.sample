# --- メール通知の送信サーバー（カゴヤ）。無ければメール通知は「未設定」として黙ってスキップ ---
#   ★検証用アプリでは最初は入れない（14店の実店舗へ検証メールが飛ぶのを防ぐ）。
#   使うときは下の5行の先頭の「# 」を外します。
# [smtp]
# host = "smtp.kagoya.net"
# port = 587
# user = "ここにカゴヤのログインID"
# password = "ここにパスワード"
# from = "ここに差出人アドレス"

# --- 店ごとのメール通知先（36店）。無い店には送らず「宛先未登録」として画面に知らせます ---
#   ★検証用アプリでメール実測をするときは、36店とも本間部長のアドレスにして全店板に1件投稿し、
#     35通届くことと画面の待ち時間を確かめてから、この表を空に戻します（手順書参照）。
[store_emails]
# ソユーズ薬局（9店）
"東大泉" = "dummy-store@example.invalid"
"海浜幕張" = "dummy-store@example.invalid"
