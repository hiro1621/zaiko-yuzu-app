# ============================================================
# 在庫融通アプリ（デッドストックリスト） Secrets（秘密）の見本
# ------------------------------------------------------------
# ★これは「見本」です。中身はダミー。この .sample ファイルだけをGitHubに置きます。
# ★本物は Streamlit Cloud の画面「App settings ▸ Secrets」に、この形で貼り付けます。
#   （ローカルで試すときだけ、このファイルを同じフォルダに「secrets.toml」という名前で
#     コピーして中身を本物に書き換えます。secrets.toml は .gitignore で除外済み＝上がりません。）
# ★2026-09-18 3法人対応（36店）：合言葉を「店ごと」にしました（[store_passwords]）。
#   本番の合言葉の値は、事務ポータルのトークン控え2本（ソユーズ・内観堂14店／飛鳥22店）から店ごとに写します。
# ★2026-09-19：管理者（本部モード）の合言葉を「名前ごと」7人ぶんにしました（[admin_passwords]）。
#   管理者7人分・検証用アプリの店の合言葉は docs\3法人対応改修_202610\_検証用合言葉を作る.py が出す値を使います。
# ★書く順番の注意：[角かっこ] の見出しより上に「1行の項目」（spreadsheet_id・app_url・旧 admin_password）を
#   全部書きます。見出しの下に書くと、その表の中身として読まれてしまい、効かなくなります。
# ============================================================

# --- 旧・1つだけの本部用の合言葉（[admin_passwords] があればそちらを推奨。後方互換で残してあります） ---
#   これで入ると左バーの名前は「本部」になります。使うなら先頭の「# 」を外します。
#   ★[admin_passwords] のどれか・[store_passwords] のどれかと同じ値にしないこと（同じ値だとその値では入れません）。
# admin_password = "ここに旧・本部用の合言葉を入れる"

# --- 後方互換：共有パスワード1つ（[store_passwords] が無いときだけ使われます） ---
#   [store_passwords] を入れたら、この行は消してかまいません（残しても無視されます）。
# app_password = "ここに共有パスワードを入れる"

# --- GoogleスプレッドシートのID ---
#   対象シートのURL  https://docs.google.com/spreadsheets/d/【この部分】/edit
#   の【この部分】を貼ります。検証用アプリでは「コピーしたシート」のIDを入れます。
spreadsheet_id = "ここにスプレッドシートIDを入れる"

# --- アプリのURL（メール本文のリンクに使う。?store=店名 を自動で付けます） ---
#   検証用アプリでは検証用のURL、本番では本番のURLを入れます。
app_url = "https://ここにアプリのURL.streamlit.app"

# --- 管理者の合言葉（7人・名前ごと）。どの名前で入っても本部モード＝36店を自由に切り替えできる ---
#   ・キーは名前（stores_config.py の ADMIN_NAMES と同じ7人・同じ並び）。店舗には配らない。
#   ・左バーに「本部モード：本間（36店を自由に切り替えできます）」のように名前が出ます。
#   ・同じ値を2か所以上（管理者どうし・管理者と店）に入れると、その値では入れなくなります。
#   ・値が空（""）の人は、その合言葉では入れません（まだ配らない人は空のままでよい）。
[admin_passwords]
"本間" = "ダミー_本間"
"森田" = "ダミー_森田"
"小島" = "ダミー_小島"
"ソユーズ担当者" = "ダミー_ソユーズ担当者"
"内観堂担当者" = "ダミー_内観堂担当者"
"加藤" = "ダミー_加藤"
"飛鳥薬局担当者" = "ダミー_飛鳥薬局担当者"

# --- 店ごとの合言葉（36店）。キーは stores_config.py の店名そのまま（改名しない） ---
#   ・入れた合言葉と一致した店が「自店」に固定されます（店の選び直しはできません）。
#   ・同じ値を2店（または管理者と店）に入れると、その値では入れなくなります（黙って片方に入れない）。
#   ・値が空（""）の店は、その合言葉では入れません（まだ配らない店は空のままでよい）。
[store_passwords]
# ソユーズ薬局（9店）
"東大泉" = "ダミー_東大泉"
"海浜幕張" = "ダミー_海浜幕張"
"自由が丘" = "ダミー_自由が丘"
"東立石" = "ダミー_東立石"
