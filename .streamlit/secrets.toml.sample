"柏" = "ダミー_柏"
"柏駅前" = "ダミー_柏駅前"
# 内観堂薬局（5店）
"みずほ台" = "ダミー_みずほ台"
"さと和光" = "ダミー_さと和光"
"氷川台" = "ダミー_氷川台"
"徳丸" = "ダミー_徳丸"
"下落合" = "ダミー_下落合"
# 飛鳥薬局（22店）
