# ============================================================
# 在庫融通アプリ Secrets（秘密）の見本
# ------------------------------------------------------------
# ★これは「見本」です。中身はダミー。この .sample ファイルだけをGitHubに置きます。
# ★本物は Streamlit Cloud の画面「App settings ▸ Secrets」に、この形で貼り付けます。
#   （ローカルで試すときだけ、このファイルを同じフォルダに「secrets.toml」という名前で
#     コピーして中身を本物に書き換えます。secrets.toml は .gitignore で除外済み＝上がりません。）
# ============================================================

# --- 店舗の共有パスワード（1つ）。画面の最初のゲートで使います ---
app_password = "ここに共有パスワードを入れる"

# --- GoogleスプレッドシートのID ---
#   対象シートのURL  https://docs.google.com/spreadsheets/d/【この部分】/edit
#   の【この部分】を貼ります。
spreadsheet_id = "ここにスプレッドシートIDを入れる"

# --- サービスアカウント鍵(JSON)の中身を、そのままTOML表として貼る ---
#   Google Cloud で作った鍵ファイル（*.json）を開き、各項目をここへ写します。
#   ★private_key は改行を \n のままにして、前後をダブルクォートで囲みます。
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...（ここに鍵本体）...\n-----END PRIVATE KEY-----\n"
client_email = "yuzu-bot@your-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/yuzu-bot%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
